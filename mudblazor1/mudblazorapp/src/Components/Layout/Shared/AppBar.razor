
<MudAppBar Elevation="1"
           Color="Color.Primary"
           Dense="false"
           Class="app-toolbar">

    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   OnClick="HandleMenuClick"
                   aria-label="Toggle navigation" />

    <MudText Typo="Typo.h6" Class="ml-2">
        Church Manager
    </MudText>

    <MudSpacer />

    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                   Color="Color.Inherit"
                   aria-label="Notifications" />

    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                   Color="Color.Inherit"
                   aria-label="User account" />
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnMenuClick { get; set; }

    private Task HandleMenuClick()
        => OnMenuClick.InvokeAsync();
}
